---
import Layout from "../layouts/Layout.astro";

// 1. Definimos los moldes de diseño artístico para la galería (se repetirán cíclicamente)
const aspectPatterns = [
  "aspect-[4/5] w-[280px] md:w-[340px]",    // Retrato
  "aspect-[16/10] w-[380px] md:w-[480px]",  // Paisaje
  "aspect-square w-[300px] md:w-[380px]"    // Cuadrado
];

// 2. Función para generar imágenes en masa sin escribir líneas de más
const generateImages = (basePath, prefix, totalFiles) => {
  return Array.from({ length: totalFiles }, (_, i) => {
    const index = i + 1;
    return {
      src: `${basePath}/${index}${prefix}.webp`,
      // Asigna automáticamente un diseño diferente a cada foto consecutiva
      aspect: aspectPatterns[i % aspectPatterns.length] 
    };
  });
};

// 3. Estructura de Datos Limpia, escalable y centralizada
const galleryData = {
  "art-festival": {
    // Genera automáticamente las 12 fotos del festival
    "2026": generateImages("/festivalarte/festival2026", "mermaid", 20),
    "2025": generateImages("/festivalarte/festival2025", "shrek", 20),
  },
  "stars-cup": {
    "2026": generateImages("/copadelasestrellas/copa2026", "cup2026", 20),
    "2025": []
  },
  "business-day": {
    "2026": generateImages("/bussinesday/buss2026", "Bussines2026", 18),
    "2025": []
  }
};
---

<Layout title="Chronicles - Talentia">
  <div class="relative min-h-screen flex flex-col justify-between overflow-hidden bg-[#FFFFFF] px-4 py-8 select-none">
    
    <!-- Luces de fondo sutiles sobre blanco -->
    <div class="absolute top-1/3 left-1/4 w-[500px] h-[500px] bg-[#507687]/5 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-orange-500/40 rounded-full blur-[140px] opacity-10 pointer-events-none"></div>

    <!-- Retícula de fondo estilo papel técnico/editorial -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#f3f4f6_1px,transparent_1px),linear-gradient(to_bottom,#f3f4f6_1px,transparent_1px)] bg-[size:5rem_5rem] [mask-image:radial-gradient(ellipse_80%_80%_at_50%_50%,#000_60%,transparent_100%)] opacity-70 pointer-events-none"></div>

    <!-- Cabecera Limpia: Logo de retorno al hogar -->
    <header class="relative z-20 w-full flex justify-center pt-4">
      <a href="/" class="group transition-transform duration-500 hover:scale-105 active:scale-95">
        <img 
          src="/LogoPequeno.png" 
          alt="Logo Talentia" 
          class="w-full max-w-[140px] h-auto drop-shadow-[0_2px_8px_rgba(0,0,0,0.03)]"
        />
      </a>
    </header>

    <!-- CARD CONTENEDORA TRANSPARENTE DE EXPOSICIÓN -->
    <main class="relative z-10 w-full max-w-[95vw] lg:max-w-[85vw] mx-auto my-auto bg-white/40 backdrop-blur-md border border-gray-100/80 rounded-[32px] p-6 md:p-12 shadow-[0_20px_50px_rgba(0,0,0,0.02)] flex flex-col justify-center min-h-[60vh] group/main">
      
      <!-- Navegación de Categorías -->
      <nav class="flex justify-center gap-6 md:gap-10 border-b border-gray-100 pb-6 mb-8 overflow-x-auto no-scrollbar">
        <button data-event="art-festival" class="event-btn relative py-1 text-[11px] uppercase tracking-[0.25em] font-medium transition-all duration-500 text-gray-900">
          Festival de Arte
          <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-[#507687] transition-transform duration-500 origin-left scale-x-100 line-indicator"></span>
        </button>
        <button data-event="stars-cup" class="event-btn relative py-1 text-[11px] uppercase tracking-[0.25em] font-medium transition-all duration-500 text-gray-400 hover:text-gray-900">
          Stars Cup
          <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-[#507687] transition-transform duration-500 origin-left scale-x-0 line-indicator"></span>
        </button>
        <button data-event="business-day" class="event-btn relative py-1 text-[11px] uppercase tracking-[0.25em] font-medium transition-all duration-500 text-gray-400 hover:text-gray-900">
          Bussines Day
          <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-[#507687] transition-transform duration-500 origin-left scale-x-0 line-indicator"></span>
        </button>
      </nav>

      <!-- Área Central de Exhibición -->
      <div class="relative flex flex-col md:flex-row items-center gap-8 w-full">
        
        <!-- Contenedor del Scroller y las Flechas Editoriales -->
        <div class="relative w-full overflow-hidden flex items-center">
          
          <!-- Flecha Izquierda Minimalista -->
          <button id="scroll-prev" class="absolute left-2 z-30 p-3 rounded-full bg-white/80 border border-gray-100 text-gray-800 shadow-sm backdrop-blur-sm opacity-0 group-hover/main:opacity-100 md:translate-x-[-10px] group-hover/main:translate-x-0 transition-all duration-500 focus:outline-none hover:bg-gray-900 hover:text-white" aria-label="Anterior">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>

          <!-- Carrete de Imágenes Horizontal -->
          <div class="w-full overflow-x-auto py-6 px-4 flex items-center gap-8 no-scrollbar scroll-smooth snap-x snap-mandatory" id="gallery-scroller">
            <!-- Las imágenes flotantes se inyectan dinámicamente aquí -->
          </div>

          <!-- Flecha Derecha Minimalista -->
          <button id="scroll-next" class="absolute right-2 z-30 p-3 rounded-full bg-white/80 border border-gray-100 text-gray-800 shadow-sm backdrop-blur-sm opacity-0 group-hover/main:opacity-100 md:translate-x-[10px] group-hover/main:translate-x-0 transition-all duration-500 focus:outline-none hover:bg-gray-900 hover:text-white" aria-label="Siguiente">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>

        </div>

        <!-- Selector Interactivo Lateral de Año -->
        <div class="flex md:flex-col justify-center gap-6 border-t md:border-t-0 md:border-l border-gray-100 pt-4 md:pt-0 md:pl-6 shrink-0 font-serif">
          <button data-year="2026" class="year-btn text-lg md:text-xl font-light transition-all duration-500 text-[#507687] scale-110 font-medium">
            2026
          </button>
          <button data-year="2025" class="year-btn text-lg md:text-xl font-light transition-all duration-500 text-gray-300 hover:text-gray-600">
            2025
          </button>
        </div>

      </div>

      <!-- Estado Vacío Ultra Limpio -->
      <div id="collection-empty" class="hidden absolute inset-0 flex items-center justify-center pointer-events-none">
        <span class="font-serif italic text-gray-300 text-sm md:text-base tracking-widest">Próxima Edición Coleccionable</span>
      </div>

    </main>

  </div>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline define:vars={{ galleryData }}>
  let currentEvent = "art-festival";
  let currentYear = "2026";

  const eventButtons = document.querySelectorAll(".event-btn");
  const yearButtons = document.querySelectorAll(".year-btn");
  const scroller = document.getElementById("gallery-scroller");
  const emptyState = document.getElementById("collection-empty");
  const btnPrev = document.getElementById("scroll-prev");
  const btnNext = document.getElementById("scroll-next");

  if (btnPrev && btnNext && scroller) {
    btnNext.addEventListener("click", () => {
      scroller.scrollLeft += scroller.clientWidth * 0.6;
    });
    btnPrev.addEventListener("click", () => {
      scroller.scrollLeft -= scroller.clientWidth * 0.6;
    });
  }

  function renderCollection() {
    scroller.innerHTML = "";
    const activeItems = galleryData[currentEvent]?.[currentYear] || [];

    if (activeItems.length === 0) {
      scroller.classList.add("opacity-0");
      emptyState.classList.remove("hidden");
      return;
    }

    scroller.classList.remove("opacity-0");
    emptyState.classList.add("hidden");

    activeItems.forEach(item => {
      const itemFrame = document.createElement("div");
      itemFrame.className = `snap-center shrink-0 overflow-hidden rounded-2xl bg-gray-50 border border-gray-100/50 shadow-[0_10px_30px_rgba(0,0,0,0.02)] transition-all duration-[1s] cubic-bezier(0.25, 1, 0.5, 1) hover:shadow-[0_20px_40px_rgba(80,118,135,0.08)] hover:-translate-y-2 ${item.aspect}`;

      itemFrame.innerHTML = `
        <img 
          src="${item.src}" 
          class="w-full h-full object-cover filter saturate-[0.85] hover:saturate-100 transition-all duration-[1.2s] ease-out hover:scale-105"
          loading="lazy"
        />
      `;
      scroller.appendChild(itemFrame);
    });
  }

  eventButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      eventButtons.forEach(b => {
        b.classList.remove("text-gray-900");
        b.classList.add("text-gray-400");
        b.querySelector(".line-indicator").classList.replace("scale-x-100", "scale-x-0");
      });
      btn.classList.add("text-gray-900");
      btn.classList.remove("text-gray-400");
      btn.querySelector(".line-indicator").classList.replace("scale-x-0", "scale-x-100");

      currentEvent = btn.dataset.event;
      renderCollection();
    });
  });

  yearButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      yearButtons.forEach(b => {
        b.classList.remove("text-[#507687]", "scale-110", "font-medium");
        b.classList.add("text-gray-300");
      });
      btn.classList.add("text-[#507687]", "scale-110", "font-medium");
      btn.classList.remove("text-gray-300");

      currentYear = btn.dataset.year;
      renderCollection();
    });
  });

  // Inicialización Única
  renderCollection();
</script>