---
import Layout from "../layouts/Layout.astro";

const { itemsInCategory, categoryInfo, activeItemSlug } = Astro.props;

type Item = (typeof itemsInCategory)[number];

const firstItem =
  itemsInCategory.find((item: Item) => item.id === activeItemSlug)?.data ??
  itemsInCategory[0].data;
---

<>
  <div class="w-full flex justify-center items-center mb-10 pt-10">
    <a href="/">
      <img
        src="/LogoPequeno.png"
        alt="Logo"
        class="w-full max-w-[250px] h-auto"
      />
    </a>
  </div>

  <div class="flex flex-col lg:flex-row gap-6 mt-12 md:mt-16 lg:mt-20 px-4 md:px-8 justify-center">
    
    <div class="flex-1 max-w-xl mx-auto lg:mx-0">
      <img
        id="selected-image"
        src={firstItem.image}
        alt={firstItem.title}
        class="w-full rounded shadow-md object-cover transition-opacity duration-500 ease-in-out opacity-100"
      />
    </div>

    <div class="flex-1 max-w-xl mx-auto lg:mx-0">
      <h1
        id="selected-title"
        class="italic font-bold text-4xl text-[#507687] mb-2"
      >
        {firstItem.title}
      </h1>

      <p
        id="selected-description"
        class="text-[#507687] text-base mb-4"
      >
        {firstItem.description}
      </p>

      <h3 id="selected-edad" class="italic text-base text-[#507687] mb-2">
        {firstItem.edad}
      </h3>

      <h3 id="selected-lugar" class="italic text-base text-[#507687] mb-2">
        {firstItem.lugar}
      </h3>

      <h3 id="selected-horario" class="italic text-base text-[#507687] mb-4">
        {firstItem.horario}
      </h3>

      <div class="mt-4">
        <button
          id="btn-inscribirse"
          class="inline-block px-6 py-3 bg-[#507687] text-white font-semibold rounded-lg shadow hover:bg-orange-600 transition-colors duration-300 text-center w-full md:w-auto"
        >
          Inscribirse
        </button>

        <p id="mensaje-inscripcion" class="mt-3 text-sm text-[#507687]"></p>
      </div>
    </div>

    <div class="flex overflow-x-auto lg:overflow-x-hidden lg:flex-col gap-2 mt-4 lg:mt-0 mx-auto lg:mx-0">
      {
        itemsInCategory.map((item: Item) => (
          <button
            type="button"
            data-title={item.data.title}
            data-description={item.data.description}
            data-image={item.data.image}
            data-edad={item.data.edad}
            data-lugar={item.data.lugar}
            data-horario={item.data.horario}
            data-abierta={String(item.data.inscripcion_abierta)}
            data-link={`/categories/${item.data.category}/${item.id}`}
            aria-label={`Cambiar a ${item.data.title}`}
            class="academia-btn focus:outline-none relative overflow-hidden rounded shadow group w-20 h-20 md:w-24 md:h-24 flex-shrink-0"
          >
            <img
              src={item.data.image}
              alt={item.data.title}
              class="w-full h-full object-cover transition-all duration-300 ease-in-out group-hover:ring-2 group-hover:ring-orange-500"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent flex items-end p-1 md:p-2 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
              <span class="text-white text-[10px] md:text-xs font-semibold leading-tight text-left w-full line-clamp-2">
                {item.data.title}
              </span>
            </div>
          </button>
        ))
      }
    </div>

  </div>

  <script is:inline>
    const titleEl = document.getElementById("selected-title");
    const descEl = document.getElementById("selected-description");
    const imageEl = document.getElementById("selected-image");
    const edadEl = document.getElementById("selected-edad");
    const lugarEl = document.getElementById("selected-lugar");
    const horarioEl = document.getElementById("selected-horario");
    const mensaje = document.getElementById("mensaje-inscripcion");

    /*
    =========================================
    CAMBIO DE ACADEMIA INTERACTIVO
    =========================================
    */
    function updateContent({ title, description, image, edad, lugar, horario, link, abierta }) {
      titleEl.textContent = title;
      descEl.textContent = description;
      edadEl.textContent = edad;
      lugarEl.textContent = lugar;
      horarioEl.textContent = horario;

      // Resetear o pre-visualizar el estado de la inscripción al cambiar de vista
      if (mensaje) {
        if (abierta === "false") {
          mensaje.textContent = "Las inscripciones están deshabilitadas";
          mensaje.className = "mt-3 text-sm text-red-500";
        } else {
          mensaje.textContent = "";
          mensaje.className = "mt-3 text-sm text-[#507687]";
        }
      }

      imageEl.classList.add("opacity-0");

      setTimeout(() => {
        imageEl.src = image;
        imageEl.alt = title;
        imageEl.classList.remove("opacity-0");
      }, 200);

      window.history.pushState({}, "", link);
    }

    const academiaButtons = document.querySelectorAll(".academia-btn");

    academiaButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const { title, description, image, edad, lugar, horario, link, abierta } = btn.dataset;
        
        updateContent({ title, description, image, edad, lugar, horario, link, abierta });
      });
    });

    /*
    =========================================
    PROCESO DE INSCRIPCIÓN
    =========================================
    */
    const btnInscribir = document.getElementById("btn-inscribirse");

    btnInscribir?.addEventListener("click", async () => {
      if (mensaje) {
        mensaje.textContent = "Validando...";
        mensaje.className = "mt-3 text-sm text-[#507687]";
      }

      const slug = window.location.pathname.split("/").pop();
      const email = localStorage.getItem("emailUsuario");

      try {
        const response = await fetch("/api/inscribirse", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ slug, email })
        });

        const data = await response.json();

        if (!response.ok) {
          if (mensaje) {
            mensaje.textContent = data.error;
            mensaje.className = "mt-3 text-sm text-red-500";
          }
          return;
        }

        if (mensaje) {
          mensaje.textContent = "Inscripción realizada correctamente";
          mensaje.className = "mt-3 text-sm text-green-600";
        }
      } catch {
        if (mensaje) {
          mensaje.textContent = "Error conexión servidor";
          mensaje.className = "mt-3 text-sm text-red-500";
        }
      }
    });
  </script>
</>