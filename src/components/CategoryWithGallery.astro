---
import Layout from "../layouts/Layout.astro";

const { itemsInCategory, categoryInfo, activeItemSlug } = Astro.props;

type Item = (typeof itemsInCategory)[number];
const firstItem =
  itemsInCategory.find((item: Item) => item.id === activeItemSlug)?.data ??
  itemsInCategory[0].data;
---

<>
  <div class="w-full flex justify-center items-center mb-10 pt-10">
    <a href="/">
      <img
        src="/LogoPequeno.png"
        alt="Logo"
        class="w-full max-w-[250px] h-auto"
      />
    </a>
  </div>

  <div class="flex flex-col lg:flex-row gap-6 mt-12 md:mt-16 lg:mt-20 px-4 md:px-8 justify-center">
    
    <div class="flex-1 max-w-xl mx-auto lg:mx-0">
      <img
        id="selected-image"
        src={firstItem.image}
        alt={firstItem.title}
        class="w-full rounded shadow-md object-cover transition-opacity duration-500 ease-in-out opacity-100"
      />
    </div>

    <div class="flex-1 max-w-xl mx-auto lg:mx-0">
      <h1
        id="selected-title"
        class="italic font-bold text-4xl text-[#507687] mb-2"
      >
        {firstItem.title}
      </h1>

      <p
        id="selected-description"
        class="text-[#507687] text-base mb-4"
      >
        {firstItem.description}
      </p>

      <h3 id="selected-edad" class="italic text-base text-[#507687] mb-2">
        {firstItem.edad}
      </h3>

      <h3 id="selected-lugar" class="italic text-base text-[#507687] mb-2">
        {firstItem.lugar}
      </h3>

      <h3 id="selected-horario" class="italic text-base text-[#507687] mb-4">
        {firstItem.horario}
      </h3>

      <div class="mt-4">
        <button
          id="btn-inscribirse"
          class="inline-block px-6 py-3 bg-[#507687] text-white font-semibold rounded-lg shadow hover:bg-orange-600 transition-colors duration-300 text-center w-full md:w-auto disabled:bg-gray-400 disabled:hover:bg-gray-400 disabled:cursor-not-allowed"
        >
          Inscribirse
        </button>

        <p id="mensaje-inscripcion" class="mt-3 text-sm text-[#507687]"></p>
      </div>
    </div>

    <div class="flex overflow-x-auto lg:overflow-x-hidden lg:flex-col gap-2 mt-4 lg:mt-0 mx-auto lg:mx-0">
      {
        itemsInCategory.map((item: Item) => (
          <button
            type="button"
            data-title={item.data.title}
            data-description={item.data.description}
            data-image={item.data.image}
            data-edad={item.data.edad}
            data-lugar={item.data.lugar}
            data-horario={item.data.horario}
            data-abierta={String(item.data.inscripcion_abierta)}
            data-cierre={item.data.fecha_cierre ?? ""}
            data-link={`/categories/${item.data.category}/${item.id}`}
            aria-label={`Cambiar a ${item.data.title}`}
            class="academia-btn focus:outline-none relative overflow-hidden rounded shadow group w-20 h-20 md:w-24 md:h-24 flex-shrink-0"
          >
            <img
              src={item.data.image}
              alt={item.data.title}
              class="w-full h-full object-cover transition-all duration-300 ease-in-out group-hover:ring-2 group-hover:ring-orange-500"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent flex items-end p-1 md:p-2 transition-opacity duration-300 pointer-events-none">
              <span class="text-white text-[10px] md:text-xs font-semibold leading-tight text-left w-full line-clamp-2">
                {item.data.title}
              </span>
            </div>
          </button>
        ))
      }
    </div>

  </div>

  <script>
    import { supabase } from "../lib/supabase";

    const titleEl = document.getElementById("selected-title") as HTMLHeadingElement | null;
    const descEl = document.getElementById("selected-description") as HTMLParagraphElement | null;
    const imageEl = document.getElementById("selected-image") as HTMLImageElement | null;
    const edadEl = document.getElementById("selected-edad") as HTMLHeadingElement | null;
    const lugarEl = document.getElementById("selected-lugar") as HTMLHeadingElement | null;
    const horarioEl = document.getElementById("selected-horario") as HTMLHeadingElement | null;
    const mensaje = document.getElementById("mensaje-inscripcion") as HTMLParagraphElement | null;
    const btnInscribir = document.getElementById("btn-inscribirse") as HTMLButtonElement | null;

    interface UpdateContentParams {
      title: string;
      description: string;
      image: string;
      edad: string;
      lugar: string;
      horario: string;
      link: string;
      abierta: string;
      cierre: string;
    }

    /*
    =========================================
    CAMBIO DE ACADEMIA INTERACTIVO & TIEMPO REAL
    =========================================
    */
    function updateContent({ title, description, image, edad, lugar, horario, link, abierta, cierre }: UpdateContentParams): void {
      if (titleEl) titleEl.textContent = title;
      if (descEl) descEl.textContent = description;
      if (edadEl) edadEl.textContent = edad;
      if (lugarEl) lugarEl.textContent = lugar;
      if (horarioEl) horarioEl.textContent = horario;

      // EVALUACIÓN DE FECHA INTELIGENTE EN EL FRONTEND
      const ahora = new Date();
      const fechaCierreDate = cierre ? new Date(cierre) : null;
      const haExpiradoElTiempo = fechaCierreDate && ahora > fechaCierreDate;

      if (mensaje && btnInscribir) {
        if (abierta === "false" || haExpiradoElTiempo) {
          btnInscribir.disabled = true;
          mensaje.textContent = haExpiradoElTiempo 
            ? "⏰ El tiempo límite de inscripción ha expirado" 
            : "Las inscripciones están deshabilitadas";
          mensaje.className = "mt-3 text-sm text-red-500 font-medium";
        } else {
          btnInscribir.disabled = false;
          mensaje.textContent = "";
          mensaje.className = "mt-3 text-sm text-[#507687]";
        }
      }

      if (imageEl) {
        imageEl.classList.add("opacity-0");
        setTimeout(() => {
          imageEl.src = image;
          imageEl.alt = title;
          imageEl.classList.remove("opacity-0");
        }, 200);
      }

      window.history.pushState({}, "", link);
    }

    const academiaButtons = document.querySelectorAll<HTMLButtonElement>(".academia-btn");

    academiaButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const { title, description, image, edad, lugar, horario, link, abierta, cierre } = btn.dataset;
        
        if (title && image && link) {
          updateContent({ 
            title, 
            description: description || "", 
            image, 
            edad: edad || "", 
            lugar: lugar || "", 
            horario: horario || "", 
            link, 
            abierta: abierta || "false",
            cierre: cierre || ""
          });
        }
      });
    });

    /*
    =========================================
    VALIDACIÓN AL INICIAR LA PÁGINA (PRIMERA CARGA)
    =========================================
    */
    function inicializarValidacionCarga(): void {
      const slugActual = window.location.pathname.split("/").pop();
      const botonActivo = Array.from(academiaButtons).find(btn => btn.dataset.link?.endsWith("/" + slugActual));
      
      if (botonActivo) {
        const { title, description, image, edad, lugar, horario, link, abierta, cierre } = botonActivo.dataset;
        if (title && image && link) {
          updateContent({
            title,
            description: description || "",
            image,
            edad: edad || "",
            lugar: lugar || "",
            horario: horario || "",
            link,
            abierta: abierta || "false",
            cierre: cierre || ""
          });
        }
      } else if (academiaButtons.length > 0) {
        // Si entra a la categoría padre por primera vez
        const { title, description, image, edad, lugar, horario, link, abierta, cierre } = academiaButtons[0].dataset;
        if (title && image && link) {
          updateContent({
            title, description: description || "", image, edad: edad || "", lugar: lugar || "", horario: horario || "", link, abierta: abierta || "false", cierre: cierre || ""
          });
        }
      }
    }

    // Ejecutar al cargar la vista
    inicializarValidacionCarga();

    /*
    =========================================
    MANEJADOR DE REDIRECCIÓN A GOOGLE (SUPABASE)
    =========================================
    */
    async function iniciarSesionGoogle(): Promise<void> {
      await supabase.auth.signInWithOAuth({
        provider: "google",
        options: {
          redirectTo: window.location.href
        }
      });
    }

    function asociarEventoLogin(): void {
      const loginLink = document.getElementById("login-link-trigger");
      if (loginLink) {
        loginLink.addEventListener("click", async (e) => {
          e.preventDefault();
          await iniciarSesionGoogle();
        });
      }
    }

    /*
    =========================================
    PROCESO DE INSCRIPCIÓN
    =========================================
    */
    btnInscribir?.addEventListener("click", async () => {
      if (mensaje) {
        mensaje.textContent = "Validando...";
        mensaje.className = "mt-3 text-sm text-[#507687]";
      }

      const slug = window.location.pathname.split("/").pop();
      const email = localStorage.getItem("emailUsuario");

      if (!email) {
        if (mensaje) {
          mensaje.innerHTML = 'Usuario no autenticado. <button type="button" id="login-link-trigger" class="underline font-bold text-orange-600 hover:text-orange-700 cursor-pointer">Inicia sesión aquí con Google</button>';
          mensaje.className = "mt-3 text-sm text-red-500";
          asociarEventoLogin();
        }
        return;
      }

      try {
        const response = await fetch("/api/inscribirse", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ slug, email })
        });

        const data = await response.json();

        if (!response.ok) {
          if (mensaje) {
            if (data && typeof data === 'object' && 'error' in data) {
              const errMsg = String(data.error);
              if (errMsg === "Perfil estudiante no encontrado") {
                mensaje.innerHTML = 'Tu cuenta no está registrada como estudiante. <button type="button" id="login-link-trigger" class="underline font-bold text-orange-600 hover:text-orange-700 cursor-pointer">Inicia sesión con otra cuenta de Google</button>';
                asociarEventoLogin();
              } else if (errMsg === "El tiempo límite de inscripción ha expirado") {
                mensaje.textContent = "⏰ El tiempo límite de inscripción ha expirado";
                if (btnInscribir) btnInscribir.disabled = true;
              } else {
                mensaje.textContent = errMsg;
              }
            } else {
              mensaje.textContent = "Error al procesar la solicitud";
            }
            mensaje.className = "mt-3 text-sm text-red-500";
          }
          return;
        }

        if (mensaje) {
          mensaje.textContent = "Inscripción realizada correctamente";
          mensaje.className = "mt-3 text-sm text-green-600";
        }
      } catch {
        if (mensaje) {
          mensaje.textContent = "Error conexión servidor";
          mensaje.className = "mt-3 text-sm text-red-500";
        }
      }
    });
  </script>
</>