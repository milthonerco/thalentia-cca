---
const links = [
  { name: 'Tecnología', href: '/categories/mr-mascadedo-tech/robotics'},
  { name: 'Estilo de Vida', href: '/categories/lifestyle/crafts' },
  { name: 'Arte', href: '/categories/art-festival/dance-choreography' },
  { name: 'Deportes', href: '/categories/stars-cup/basketball' },
  { name: 'Eventos', href: '/eventos' },
];
---

<nav
  id="mainNavbar"
  class="fixed top-0 left-0 w-full bg-transparent text-[#FFFCFB] px-6 py-4 md:py-6 z-20 drop-shadow-[0_0_10px_black] transition-all duration-300"
>
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:justify-center md:items-center relative">
    
    <div class="flex justify-start items-center w-full md:w-auto md:hidden">
      <button
        id="hamburgerBtn"
        type="button"
        class="text-[#FFFCFB] hover:opacity-80 focus:outline-none p-2"
        aria-label="Abrir menú de navegación"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path id="hamburgerIcon" fill-rule="evenodd" d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z"/>
        </svg>
      </button>
    </div>

    <div
      id="navbarMenu"
      class="hidden w-full md:w-auto md:flex flex-col md:flex-row items-center pt-4 md:pt-0 bg-white md:bg-transparent text-[#507687] md:text-[#FFFCFB] rounded-b-xl md:rounded-none p-4 md:p-0 shadow-lg md:shadow-none"
    >
      <ul class="flex flex-col md:flex-row items-center w-full gap-y-4 md:gap-x-6 lg:gap-x-8 uppercase font-bold text-center">
        {
          links.map((link) => (
            <li class="w-full md:w-auto">
              <a
                href={link.href}
                class="block py-2 md:py-0 hover:text-[#9B177E] md:hover:text-[#9B177E] text-sm md:text-lg lg:text-xl transition duration-200"
              >
                {link.name}
              </a>
            </li>
          ))
        }

        <li class="w-full md:w-auto pt-2 md:pt-0">
          <button
            id="studentBtn"
            class="w-full md:w-auto py-2 px-4 md:py-0 md:px-0 bg-[#507687] text-white md:text-inherit md:bg-transparent rounded-lg md:rounded-none hover:opacity-80 md:hover:text-[#9B177E] text-sm md:text-lg lg:text-xl uppercase transition duration-200"
          >
            Estudiantes
          </button>
        </li>
      </ul>
    </div>

  </div>
</nav>

<script>
  import "../scripts/navbar";
</script>